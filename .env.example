POCKETWIKI_REFERENCE_PATH="/absolute/path/to/reference/wiki"
POCKETWIKI_REFERENCE_READONLY=true
# Escrita via PUT /api/v1/solutions/{solution_id}; mantenha vazio se não usar.
POCKETWIKI_WRITE_TOKEN=""
# O servidor nunca aceita limite menor que 8 MiB.
POCKETWIKI_WRITE_MAX_BYTES=8388608
# Use 80 para acessar como http://pocketwiki.local sem porta.
# Se o SO negar permissao, use 8787 ou rode com sudo/reverse proxy.
POCKETWIKI_PORT=80
POCKETWIKI_BIND_HOST="0.0.0.0"
POCKETWIKI_PUBLIC_HOSTS="pocketwiki.local,pokectwiki.local"
POCKETWIKI_MDNS=true

LM_STUDIO_BASE_URL="http://localhost:1234/v1"
LM_STUDIO_MODEL=""
LM_STUDIO_API_KEY=""

# PocketKernel pode continuar externo. Em "automatic", o app usa uma instância
# saudável ou inicia o binário empacotado e conecta o MCP Evidence via stdio.
POCKETKERNEL_BASE_URL="http://127.0.0.1:8080"
POCKETWIKI_POCKETKERNEL_MODE="automatic"
# Overrides explícitos de desenvolvimento; não há descoberta implícita de ../pocketkernel.
POCKETWIKI_POCKETKERNEL_BINARY=""
POCKETWIKI_NODE_BINARY=""

# MiddlewareAuth continua podendo rodar externo. Em "automatic", o app usa o
# endpoint se já estiver saudável ou inicia o helper empacotado no macOS.
MIDDLEWARE_BASE_URL="http://127.0.0.1:18787"
MIDDLEWARE_PROJECT_ID="acme"
MIDDLEWARE_LLM_PROFILE_ID="default"
POCKETWIKI_MIDDLEWARE_AUTH_MODE="automatic"
# Override explícito de desenvolvimento; nunca aponta implicitamente para ../middlewareAuth.
POCKETWIKI_MIDDLEWARE_AUTH_BINARY=""

# Signing local:
# - "auto" procura Apple Development/Developer ID no Keychain;
# - "adhoc" usa assinatura ad-hoc;
# - se quiser fixar, use o hash do certificado, não nome/e-mail/Team ID.
POCKETWIKI_SIGN_MODE="auto"
POCKETWIKI_SIGNING_IDENTITY=""
POCKETWIKI_SKIP_SECRET_SCAN="0"
POCKETWIKI_BUNDLE_ID="com.irinery.PocketWikiMac"
