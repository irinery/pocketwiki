{
  "name": "pocketwiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:excalidraw-renderer": "esbuild src/excalidraw-renderer.js --bundle --format=esm --target=es2020 --minify --outfile=assets/excalidraw-renderer.js && cp node_modules/lz-string/libs/lz-string.min.js assets/lz-string.min.js",
    "build:excalidraw-desktop": "vite build --config vite.excalidraw.config.mjs",
    "test:excalidraw-desktop": "node src/excalidraw-desktop/document.test.mjs",
    "build:excalidraw": "npm run build:excalidraw-renderer && npm run test:excalidraw-desktop && npm run build:excalidraw-desktop",
    "start": "node server.mjs",
    "start:lan80": "POCKETWIKI_PORT=80 node server.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/utils": "^0.1.3-test32",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "vite": "^8.0.14"
  }
}
