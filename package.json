{
  "name": "pocketwiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:excalidraw": "esbuild src/excalidraw-renderer.js --bundle --format=esm --target=es2020 --minify --outfile=assets/excalidraw-renderer.js && cp node_modules/lz-string/libs/lz-string.min.js assets/lz-string.min.js",
    "start": "node server.mjs",
    "start:lan80": "POCKETWIKI_PORT=80 node server.mjs"
  },
  "dependencies": {
    "@excalidraw/utils": "^0.1.3-test32",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
