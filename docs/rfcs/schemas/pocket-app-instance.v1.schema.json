{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket.dev/schemas/pocket-app-instance.v1.schema.json",
  "title": "Pocket App Instance v1",
  "description": "Descritor dinâmico e não secreto de uma instância Pocket externa.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "manifest",
    "instance_id",
    "started_at",
    "endpoints",
    "capabilities",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "pocket.app.instance/v1"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interface_id", "url"],
        "properties": {
          "interface_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*){1,3}$"
      }
    },
    "status": {
      "enum": ["starting", "ready", "degraded", "stopping", "failed"]
    }
  }
}
