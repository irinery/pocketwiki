{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket.dev/schemas/pocket-app-manifest.v1.schema.json",
  "title": "Pocket App Manifest v1",
  "description": "Manifesto normativo de um add-on ou integração da Pocket Stack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "release_channel",
    "release_tag",
    "distribution",
    "interfaces",
    "provides",
    "consumes"
  ],
  "properties": {
    "schema_version": {
      "const": "pocket.app.manifest/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "release_channel": {
      "enum": ["alpha", "stable"]
    },
    "release_tag": {
      "type": "string",
      "pattern": "^(?:alpha-)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "distribution": {
      "$ref": "#/$defs/distribution"
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "provides": {
      "$ref": "#/$defs/capabilityList"
    },
    "consumes": {
      "$ref": "#/$defs/capabilityList"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "observability": {
      "$ref": "#/$defs/observability"
    },
    "update": {
      "$ref": "#/$defs/update"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "distribution": {
            "type": "object",
            "properties": {
              "class": {
                "const": "managed-addon"
              }
            },
            "required": ["class"]
          }
        }
      },
      "then": {
        "required": ["build", "runtime"],
        "properties": {
          "distribution": {
            "type": "object",
            "properties": {
              "update_strategy": {
                "const": "atomic-with-host"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_channel": {
            "const": "alpha"
          }
        },
        "required": ["release_channel"]
      },
      "then": {
        "properties": {
          "release_tag": {
            "type": "string",
            "pattern": "^alpha-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_channel": {
            "const": "stable"
          }
        },
        "required": ["release_channel"]
      },
      "then": {
        "properties": {
          "release_tag": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      }
    }
  ],
  "$defs": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "update_strategy"],
      "properties": {
        "class": {
          "enum": [
            "managed-addon",
            "external-local",
            "external-remote",
            "ephemeral-mcp"
          ]
        },
        "update_strategy": {
          "enum": [
            "atomic-with-host",
            "self-managed",
            "informational",
            "none"
          ]
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "architectures"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 7,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "ready_timeout_ms", "shutdown_timeout_ms"],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "bind_policy": {
          "enum": ["loopback-only", "user-configured", "none"]
        },
        "ready_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "shutdown_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "restart": {
          "$ref": "#/$defs/restart"
        }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "max_attempts", "window_seconds", "backoff_seconds"],
      "properties": {
        "policy": {
          "enum": ["never", "on-failure"]
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "backoff_seconds": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          }
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "protocol", "role", "version", "transport", "auth", "required"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "protocol": {
          "enum": ["mcp", "pocket-http", "cli-json"]
        },
        "role": {
          "enum": ["client", "server"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": ["stdio", "streamable-http", "http", "subprocess"]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "enum": [
            "none",
            "host-ephemeral-bearer",
            "oauth2.1",
            "configured-bearer"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "health": {
          "$ref": "#/$defs/probe"
        },
        "readiness": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "expected_status"],
      "properties": {
        "method": {
          "enum": ["GET", "POST"]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "expected_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      }
    },
    "capabilityList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*){1,3}$"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "pocket_contract": {
          "type": "string",
          "minLength": 1
        },
        "mcp_protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "approval", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
        },
        "required": {
          "type": "boolean"
        },
        "approval": {
          "enum": ["pairing", "session", "per-operation", "none"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "well_known_path": {
          "type": "string",
          "pattern": "^/"
        },
        "mdns_service": {
          "const": "_pocket-app._tcp"
        },
        "requires_pairing": {
          "type": "boolean"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_schema": {
          "const": "pocket.event/v1"
        },
        "log_stream": {
          "enum": ["stderr", "file", "http"]
        },
        "redaction_required": {
          "type": "boolean"
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
